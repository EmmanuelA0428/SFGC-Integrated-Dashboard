# Neon Postgres (pooled connection string from Neon dashboard)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Census API (for Overview "Refresh" on ACS datasets)
# CENSUS_API_KEY=

# Optional: SFG Helper AI (Phase 1 — guidance only, read-only)
# Recommended free tier: Groq — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# ASSISTANT_MODEL=llama-3.1-8b-instant
# ASSISTANT_API_BASE_URL=https://api.groq.com/openai/v1

# Alternative: OpenAI
# OPENAI_API_KEY=
# OPENAI_API_KEY_MODEL=gpt-4o-mini

# Required only when first initializing an EMPTY production database (12+ characters).
# BOOTSTRAP_ADMIN_PASSWORD=

# Explicit, LOCAL-ONLY demo mode. Set your own passwords (8+ characters).
# SFGC_DEMO_MODE=true
# SFGC_DEMO_ADMIN_PASSWORD=
# SFGC_DEMO_EDITOR_PASSWORD=
# SFGC_DEMO_VIEWER_PASSWORD=

# Optional disposable test database. NEVER use the production database here.
# TEST_DATABASE_URL=
# TEST_ADMIN_PASSWORD=
